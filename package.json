{
    "name": "codama-renderer-openapi",
    "version": "1.0.7",
    "description": "Codama renderer that generates an OpenAPI 3.0.3 spec from a Solana program IDL",
    "exports": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/types/index.d.ts",
    "type": "commonjs",
    "files": [
        "./dist/types",
        "./dist/index.*"
    ],
    "sideEffects": false,
    "keywords": [
        "solana",
        "framework",
        "standard",
        "renderers",
        "openapi"
    ],
    "scripts": {
        "build": "rimraf dist && tsup && tsc -p ./tsconfig.declarations.json",
        "dev": "vitest",
        "lint": "eslint . && prettier --check .",
        "lint:fix": "eslint --fix . && prettier --write .",
        "test": "pnpm test:types && pnpm test:treeshakability && pnpm test:unit && pnpm test:exports",
        "test:e2e": "bash test/e2e/test.sh",
        "test:exports": "node ./test/exports/module.mjs && node ./test/exports/commonjs.cjs",
        "test:treeshakability": "agadoo dist/index.mjs",
        "test:types": "tsc --noEmit",
        "test:unit": "vitest run"
    },
    "dependencies": {
        "@codama/nodes": "^1.10.0",
        "@codama/visitors-core": "^1.10.0",
        "yaml": "^2.9.1"
    },
    "devDependencies": {
        "@codama/cli": "^1.6.3",
        "@codama/nodes-from-anchor": "^1.5.6",
        "@redocly/cli": "^2.69.0",
        "@solana-config/eslint": "^0.2.3",
        "@solana-config/prettier": "^0.1.2",
        "@types/node": "^26",
        "agadoo": "^3.0.0",
        "eslint": "^9.35.0",
        "prettier": "^3.6.2",
        "rimraf": "6.1.3",
        "tsup": "^8.5.0",
        "tsx": "^4.23.15",
        "typescript": "^5.9.2",
        "vitest": "^5.0.3"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/decaplabs/codama-openapi"
    },
    "bugs": {
        "url": "https://github.com/decaplabs/codama-openapi/issues"
    },
    "engines": {
        "node": ">=20.18.0"
    },
    "packageManager": "pnpm@10.15.1",
    "prettier": "@solana-config/prettier"
}
