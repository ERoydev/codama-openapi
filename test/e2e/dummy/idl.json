{
    "address": "Vau1t11111111111111111111111111111111111111",
    "metadata": {
        "name": "vault_example",
        "version": "0.1.0",
        "spec": "0.1.0",
        "description": "Test IDL covering PDAs, signers, fixed and caller-provided accounts"
    },
    "instructions": [
        {
            "name": "create_vault",
            "discriminator": [1, 0, 0, 0, 0, 0, 0, 0],
            "accounts": [
                { "name": "payer", "writable": true, "signer": true },
                { "name": "owner" },
                {
                    "name": "vault",
                    "writable": true,
                    "pda": {
                        "seeds": [
                            { "kind": "const", "value": [118, 97, 117, 108, 116] },
                            { "kind": "account", "path": "owner" },
                            { "kind": "arg", "path": "vault_id" }
                        ]
                    }
                },
                {
                    "name": "config",
                    "pda": {
                        "seeds": [{ "kind": "const", "value": [99, 111, 110, 102, 105, 103] }]
                    }
                },
                { "name": "system_program", "address": "11111111111111111111111111111111" }
            ],
            "args": [
                { "name": "vault_id", "type": "u64" },
                { "name": "label", "type": "string" },
                { "name": "status", "type": { "defined": { "name": "Status" } } }
            ]
        },
        {
            "name": "deposit",
            "discriminator": [2, 0, 0, 0, 0, 0, 0, 0],
            "accounts": [
                { "name": "authority", "signer": true },
                { "name": "vault", "writable": true },
                { "name": "mint" },
                { "name": "user_token_account", "writable": true },
                { "name": "referrer", "optional": true },
                { "name": "token_program", "address": "TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA" }
            ],
            "args": [
                { "name": "amount", "type": "u64" },
                { "name": "memo", "type": { "option": "string" } },
                { "name": "allowed", "type": { "vec": "pubkey" } },
                { "name": "fast", "type": "bool" },
                { "name": "hash", "type": { "array": ["u8", 32] } },
                { "name": "config", "type": { "defined": { "name": "DepositConfig" } } }
            ]
        }
    ],
    "accounts": [
        { "name": "Vault", "discriminator": [10, 0, 0, 0, 0, 0, 0, 0] },
        { "name": "Config", "discriminator": [11, 0, 0, 0, 0, 0, 0, 0] }
    ],
    "errors": [
        { "code": 6000, "name": "Unauthorized", "msg": "Only the owner can do this" },
        { "code": 6001, "name": "VaultPaused", "msg": "Vault is paused" }
    ],
    "types": [
        {
            "name": "Vault",
            "type": {
                "kind": "struct",
                "fields": [
                    { "name": "owner", "type": "pubkey" },
                    { "name": "vault_id", "type": "u64" },
                    { "name": "balance", "type": "u64" },
                    { "name": "bump", "type": "u8" },
                    { "name": "status", "type": { "defined": { "name": "Status" } } }
                ]
            }
        },
        {
            "name": "Config",
            "type": {
                "kind": "struct",
                "fields": [
                    { "name": "admin", "type": "pubkey" },
                    { "name": "fee_bps", "type": "u16" }
                ]
            }
        },
        {
            "name": "Status",
            "type": {
                "kind": "enum",
                "variants": [
                    { "name": "Active" },
                    { "name": "Paused" },
                    { "name": "Limited", "fields": [{ "name": "max", "type": "u64" }] },
                    { "name": "Range", "fields": ["u64", "u64"] }
                ]
            }
        },
        {
            "name": "DepositConfig",
            "type": {
                "kind": "struct",
                "fields": [
                    { "name": "slippage_bps", "type": "u16" },
                    { "name": "deadline", "type": "i64" }
                ]
            }
        }
    ]
}
